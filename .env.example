# --- Server ---
PORT=3000
NODE_ENV=production
# Your https address. Pages opened over plain http link here, since private rooms need https.
PUBLIC_URL=https://zentencrypted.org
# Set to 127.0.0.1 so the app is reachable ONLY through the tunnel (recommended once https works at home).
HOST=

# --- Auth (REQUIRED: 32+ random characters) ---
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
LOGIN_RATE_LIMIT_MAX=15

# --- WebSocket limits ---
WS_MAX_MESSAGES_PER_SECOND=5
WS_MAX_PAYLOAD_BYTES=12288
WS_IDLE_TIMEOUT_MS=900000

# --- Rooms made with join codes ---
ROOM_MIN_TTL_MS=300000
ROOM_MAX_TTL_MS=604800000
ROOM_DEFAULT_TTL_MS=86400000
MAX_ROOMS_PER_USER=5
MAX_ROOMS_TOTAL=500

# --- Anti-abuse shield (proof-of-work human check) ---
# Normal visitors never see it. It appears for a network that hammers
# sign-in, fails logins repeatedly, or when the whole site is flooded.
SHIELD_ENABLED=1
# Set to 1 to make EVERYONE solve it (use while you're under attack)
SHIELD_ALWAYS=0
SHIELD_AUTH_SOFT=10
SHIELD_GLOBAL_PER_10S=80
MAX_CONN_PER_IP=250
MAX_NEW_CONN_PER_MIN=500

# --- Database ---
DB_FILE=./data/db.json

# Extra allowed WebSocket origins (comma separated). Usually leave empty.
CORS_ORIGIN=

# --- Public room history ---
# The PUBLIC room's messages are saved on this server (private rooms and friend chats never are).
# Set to 0 to turn saving off completely.
PUBLIC_HISTORY=1
# Delete public messages older than this many days. 0 = keep until you delete them.
PUBLIC_HISTORY_DAYS=30
# Hard cap on how many public messages are kept (oldest dropped first).
PUBLIC_HISTORY_MAX=50000

# --- Friend messages (stored as ciphertext only) ---
# Delete friend messages older than this many days. 0 = keep them.
DM_HISTORY_DAYS=0
DM_HISTORY_MAX=200000

# --- File sharing (v2.5) ---
# Private rooms + friend chats: files are encrypted in the browser, the server only stores noise.
# #public: pictures only (PNG, JPEG, GIF, WebP), checked by their actual bytes.
UPLOADS=1
# Who can post pictures in #public: off, members, or all (guests too)
PUBLIC_UPLOADS=members
UPLOAD_MAX_MB=10
# Total space files may use on this machine
UPLOAD_STORAGE_MB=2048
# Per person, per day
UPLOAD_USER_DAILY_MB=200
# Files are deleted after this many days at the latest (sooner if their message, room or friendship goes)
UPLOAD_KEEP_DAYS=30

# --- GIF search (optional) ---
# Free key from https://developers.giphy.com (create an app, pick API). Leave empty to hide the GIF button.
# Searches and GIFs go through this server, so Giphy never sees your users' IP addresses.
GIPHY_API_KEY=
# g, pg, pg-13 or r
GIF_RATING=pg-13

# --- Roles (v2.6) ---
# The owner has full control in the staff panel (/admin). Put YOUR username here.
# Without it, the oldest account on the server becomes the owner.
OWNER_USERNAME=

# --- Embedding (v2.6.1) ---
# Other sites allowed to show ZentEncrypted inside a frame, comma-separated.
# Not set = https://slizsy.github.io. Set it to nothing (EMBED_ORIGINS=) to allow no one.
# EMBED_ORIGINS=https://slizsy.github.io
